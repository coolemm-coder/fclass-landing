{
  "mcpServers": {
    "playwright-browser": {
      "command": "/bin/bash",
      "args": [
        "/Users/admin/.claude/scripts/playwright-start.sh"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/local/Cellar/node/24.8.0/bin:/Users/admin/.npm-global/bin:/Users/admin/.local/bin:/usr/bin:/bin"
      }
    },
    "n8n-api": {
      "command": "npx",
      "args": ["-y", "n8n-mcp-server"],
      "env": {
        "N8N_BASE_URL": "https://emikss.host",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-filesystem",
        "/Users/admin/Desktop/FirstClass_Automation",
        "/Users/admin/Desktop/FC_LeadRouter"
      ]
    },
    "notebooklm": {
      "command": "npx",
      "args": ["-y", "notebooklm-mcp"]
    }
  }
}
