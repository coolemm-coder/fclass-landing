# fclass.by .htaccess
# Created 2026-04-22 to fix GSC Soft 404 warning
# Updated 2026-05-14 — block internal artifacts and canonicalize duplicate route URLs
# Updated 2026-05-21 — security headers (SEO audit)

# === SECURITY HEADERS (SEO audit 2026-05-21) ===
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

RewriteEngine On

# Redirect plain HTTP only when nginx forwards the original scheme explicitly.
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
RewriteRule ^ https://fclass.by%{REQUEST_URI} [R=301,L]

# === CANONICAL HOST REDIRECTS ===
# HTTPS is terminated before Apache on this hosting; scheme redirects are handled upstream.
RewriteCond %{HTTP_HOST} !^fclass\.by$ [NC]
RewriteRule ^ https://fclass.by%{REQUEST_URI} [R=301,L]

# Drop crawler traps from external failed callbacks and tokenized root URLs.
RewriteCond %{QUERY_STRING} (^|&)(?:token|uid|status)= [NC]
RewriteRule ^(?:index\.html)?$ https://fclass.by/? [R=301,L]

# Keep the mobile HTML implementation private while still allowing the internal mobile rewrite below.
RewriteCond %{THE_REQUEST} \s/+mobile-preview\.html[?\s] [NC]
RewriteRule ^mobile-preview\.html$ https://fclass.by/ [R=301,L]

# === PUBLIC SURFACE GUARDRAILS ===
# These directories and files are workspace/internal artifacts and must not be public landing pages.
RewriteRule (^|/)\.(?!well-known/) - [G,L]
RewriteRule ^(?:api|docs|web-panel|questionnaires|content|scripts|fclass-landing|n8n-workflows)(?:/|$) - [G,L]
RewriteRule ^blog/_template\.html$ - [G,L]
RewriteRule ^(?:firstclass-growth-playbook|firstclass-gtm-plan)\.html$ - [G,L]
RewriteRule ^(?:meta-[^/]+\.md|package(?:-lock)?\.json|vercel\.json|robots-vercel\.txt)$ - [G,L]

# Keep one canonical route URL for Minsk-Stambul to avoid cannibalization.
RewriteRule ^tickets/minsk-istanbul/?$ https://fclass.by/tickets/minsk-stambul/ [R=301,L]

# Consolidate thin "суточные апрель" post into the pillar to avoid cannibalization (SEO audit 2026-05-21).
RewriteRule ^blog/sutochnye-komandirovki-aprel-2026\.html$ https://fclass.by/blog/sutochnye-komandirovka-2026.html [R=301,L]

# Legacy nav URL without a standalone landing page.
RewriteRule ^visa-support/?$ https://fclass.by/blog/vizovaya-podderzhka-minsk.html [R=301,L]

# Retired B2C tours directory — keep crawlers and old links on an active service page.
RedirectMatch 301 ^/tours/?$ https://fclass.by/tickets/

# === MOBILE: now served by responsive index.html (2026-05-21) ===
# UA-sniffing to mobile-preview.html removed — index.html is fully responsive
# (mobile menu, sticky CTA, @media). Single page for all devices = mobile-first
# safe, no content/schema parity gap, no duplicate maintenance.
# /mobile-preview.html still 301s to / (rule above) for any old indexed URL.

# === BLOG STUB DIRECTORY REDIRECTS ===

# Orphan stubs without a .html version — redirect to blog index
RewriteRule ^blog/turkey-business-trip/?$ /blog/ [R=301,L]
RewriteRule ^blog/belavia-nha-trang-2026/?$ /blog/ [R=301,L]

# Trailing-slash duplicates — 301 to canonical .html
# Matches blog/{slug}/ where slug has no inner slash → redirect to blog/{slug}.html
RewriteRule ^blog/([^/]+)/$ https://fclass.by/blog/$1.html [R=301,L]

# === STATIC ASSET COMPRESSION ===

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml application/xml+rss text/xml
</IfModule>

# === SECURITY HEADERS ===

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# === CACHE CONTROL ===

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
