{
  "name": "fclass-pdf-lead",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fclass-pdf-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "fclass-pdf-lead"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "tg_text",
              "value": "📄 <b>PDF lead: договор + чек-лист</b>\n\n👤 <b>Имя:</b> {{$json.body.name || '—'}}\n✉️ <b>Email:</b> {{$json.body.email || '—'}}\n🏢 <b>Компания:</b> {{$json.body.company || '—'}}\n🌐 <b>Откуда:</b> https://fclass.by{{$json.body.page || '/resources/dogovor-template/'}}\n\n⏰ {{$now.format('dd.MM.yyyy HH:mm')}}\n\n💡 Этот лид скачал шаблон договора и чек-лист. TOFU-стадия, нужен nurture (через 3-7 дней — email с follow-up или Telegram-сообщение)."
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Format message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "chatId": "543428212",
        "text": "={{$json.tg_text}}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "id": "3",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [680, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_BOT_CREDS_ID",
          "name": "Telegram @travelangelby_bot"
        }
      },
      "notes": "Опционально: добавь Email node с автоответом — отправить email с PDF приветствием и ссылкой на PDF"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"received\": true, \"pdf\": \"https://fclass.by/resources/dogovor-template/shablon-korporativnyy-dogovor-aviabilety-2026.pdf\" }",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "4",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Format message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format message": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Telegram": {
      "main": [
        [
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "1",
  "id": "fclass-pdf-lead",
  "tags": [
